# ===========================
# Delivery App Backend Config
# ===========================
# Copy this file to .env and fill in the values.

# Server
SERVER_PORT=8080

# PostgreSQL Database
DB_HOST=180.93.139.29
DB_PORT=26901
DB_USER=dodao
DB_PASSWORD=
DB_NAME=Buyer_App
DB_SSLMODE=disable

# ===========================
# Authentication (JWT)
# ===========================
# Secret key for signing JWT tokens (use a strong random string, 32+ chars)
# Generate: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY_HOURS=24

# ===========================
# Google OAuth
# ===========================
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create project → OAuth consent screen → External
# 2. Credentials → Create OAuth client ID → Web application
# 3. Copy the Client ID here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===========================
# Facebook OAuth
# ===========================
# Get from: https://developers.facebook.com/apps/
# 1. Create App → Consumer type
# 2. Settings → Basic → Copy App ID and App Secret
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
